generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (porta 6543) — usado em runtime
  directUrl = env("DIRECT_URL")   // conexão direta (porta 5432) — usada só pelo prisma migrate
}

// ------------------------------------------------------------------
// TENANT — cada cliente que assina o seu CRM
// ------------------------------------------------------------------
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("trial")
  status    String   @default("active") // active | suspended | canceled
  createdAt DateTime @default(now())

  users             User[]
  contacts          Contact[]
  conversations     Conversation[]
  messages          Message[]
  templates         Template[]
  whatsappAccounts  TenantWhatsappAccount[]
  webhookEvents     WebhookEvent[]
  pipelines         Pipeline[]
  deals             Deal[]
  tags              Tag[]
  tasks             Task[]
  calendarEvents    CalendarEvent[]
  automationWebhooks AutomationWebhook[]
  automationRules    AutomationRule[]
  broadcasts        Broadcast[]
  dealCustomFieldDefinitions DealCustomFieldDefinition[]
  googleCalendarAccounts     GoogleCalendarAccount[]
  notes                      Note[]
  quickReplies               QuickReply[]

  @@map("tenants")
}

// ------------------------------------------------------------------
// CONEXÃO WHATSAPP DO TENANT — resultado do Embedded Signup
// phoneNumberId é a chave que a Meta manda em TODO webhook,
// é por ela que descobrimos a qual tenant o evento pertence.
// ------------------------------------------------------------------
model TenantWhatsappAccount {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  wabaId            String   // WhatsApp Business Account ID
  phoneNumberId     String   @unique // usado para rotear webhooks -> tenant
  businessId        String?
  displayPhoneNumber String?

  accessTokenEncrypted String  // token de acesso do tenant, criptografado
  tokenStatus           String @default("active") // active | revoked | expired

  qualityRating     String?  // GREEN | YELLOW | RED
  messagingTier     String?

  // Coexistência: número continua ativo no WhatsApp Business App (celular)
  // além da Cloud API. Ver docs: onboarding-business-app-users.
  isCoexistence      Boolean  @default(false)
  platformType       String?  // CLOUD_API | ON_PREMISE (retornado pela Graph API)
  historySyncStatus  String?  // pending | in_progress | completed | declined | failed

  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@map("tenant_whatsapp_accounts")
}

// ------------------------------------------------------------------
// USUÁRIOS (atendentes/admins) DE CADA TENANT
// ------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  name         String
  email        String
  passwordHash String
  role         String   @default("agent") // admin | agent

  createdAt    DateTime @default(now())

  assignedConversations Conversation[] @relation("AssignedAgent")
  assignedDeals         Deal[]         @relation("AssignedDeal")
  assignedTasks         Task[]         @relation("AssignedTask")
  assignedCalendarEvents CalendarEvent[] @relation("AssignedCalendarEvent")
  googleCalendarAccount  GoogleCalendarAccount?
  notes                  Note[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ------------------------------------------------------------------
// CONTATOS
// ------------------------------------------------------------------
model Contact {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  phone     String   // formato E.164
  name      String?

  createdAt DateTime @default(now())

  conversations Conversation[]
  deals         Deal[]
  tags          ContactTag[]
  tasks         Task[]
  calendarEvents CalendarEvent[]
  broadcastRecipients BroadcastRecipient[]
  notes         Note[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("contacts")
}

// ------------------------------------------------------------------
// CONVERSAS
// ------------------------------------------------------------------
model Conversation {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id])

  status         String   @default("open") // open | pending | closed
  assignedUserId String?
  assignedUser   User?    @relation("AssignedAgent", fields: [assignedUserId], references: [id])

  lastMessageAt  DateTime @default(now())
  // Marcador único de leitura (não por usuário — ainda não há atribuição
  // de conversa por atendente). "Não lida" é derivado: lastMessageAt >
  // lastReadAt E a última mensagem é inbound.
  lastReadAt     DateTime?
  createdAt      DateTime @default(now())

  messages       Message[]
  tasks          Task[]
  notes          Note[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt]) // ordenação da lista de conversas
  @@map("conversations")
}

// ------------------------------------------------------------------
// NOTAS INTERNAS — anotações do atendente sobre o contato, nunca
// enviadas pro cliente. Pertencem ao contato (ficam visíveis em
// qualquer conversa com ele), mas guardam de qual conversa nasceram
// pra dar contexto de quando foram escritas.
// ------------------------------------------------------------------
model Note {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  authorUserId String?
  authorUser   User?   @relation(fields: [authorUserId], references: [id])

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([contactId])
  @@map("notes")
}

// ------------------------------------------------------------------
// MENSAGENS
// ------------------------------------------------------------------
model Message {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id])

  direction         String   // inbound | outbound
  type              String   // text | image | audio | document | template | ...
  content           Json     // payload normalizado (texto, mídia, etc.)

  whatsappMessageId String?  @unique // id retornado pela Graph API
  status            String   @default("pending") // pending | sent | delivered | read | failed

  // De onde a mensagem veio: api (enviada/recebida via Cloud API normal),
  // business_app (enviada pelo app do celular, em contas com coexistência),
  // history_sync (importada do histórico antigo no momento da coexistência)
  source            String   @default("api")

  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@index([conversationId])
  @@index([conversationId, createdAt]) // paginação por cursor do histórico
  @@map("messages")
}

// ------------------------------------------------------------------
// TEMPLATES
// ------------------------------------------------------------------
model Template {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  name       String
  category   String
  language   String   @default("pt_BR")
  bodyText   String
  metaStatus String   @default("pending") // pending | approved | rejected

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  broadcasts Broadcast[]

  @@unique([tenantId, name, language])
  @@index([tenantId])
  @@map("templates")
}

// ------------------------------------------------------------------
// RESPOSTAS RÁPIDAS — atalhos de texto livre que o atendente monta na
// hora (sem aprovação da Meta, ao contrário do Template acima). Digitar
// "/" na conversa abre a lista pra inserir uma direto na mensagem.
// ------------------------------------------------------------------
model QuickReply {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  title   String // rótulo curto, usado pra buscar (ex: "Saudação inicial")
  content String // texto que entra na mensagem quando escolhida

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, title])
  @@index([tenantId])
  @@map("quick_replies")
}

// ------------------------------------------------------------------
// DISPAROS EM MASSA — dispara um template pra uma lista de contatos.
// Reaproveita a mesma fila/worker de envio (outboundQueue) usada pela
// conversa individual, só que em modo "template" em vez de texto livre.
// ------------------------------------------------------------------
model Broadcast {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  templateId  String
  template    Template @relation(fields: [templateId], references: [id])

  status      String   @default("draft") // draft | sending | completed | failed
  totalCount  Int      @default(0)
  sentCount   Int      @default(0)
  failedCount Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipients  BroadcastRecipient[]

  @@index([tenantId])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id])

  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id])

  status      String    @default("pending") // pending | sent | failed
  messageId   String?   @unique
  error       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([broadcastId, contactId])
  @@index([broadcastId])
  @@map("broadcast_recipients")
}

// ------------------------------------------------------------------
// WEBHOOK EVENTS — peça de idempotência e auditoria
// tenantId fica nullable pois, no momento em que o evento chega
// na fila, ainda não resolvemos a qual tenant ele pertence.
// ------------------------------------------------------------------
model WebhookEvent {
  id                String   @id @default(cuid())
  tenantId          String?
  tenant            Tenant?  @relation(fields: [tenantId], references: [id])

  whatsappEventKey  String   @unique // messageId (inbound) ou messageId+status (status update)
  phoneNumberId     String
  payload           Json
  processedAt       DateTime?
  error             String?

  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@map("webhook_events")
}

// ------------------------------------------------------------------
// PIPELINES — funis de negociação customizáveis por tenant
// (ex: "Vendas", "Suporte Premium"). Nunca deletados de verdade,
// só arquivados, pra preservar o histórico dos deals antigos.
// ------------------------------------------------------------------
model Pipeline {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  name       String
  isDefault  Boolean   @default(false)
  archivedAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  stages     PipelineStage[]
  deals      Deal[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("pipelines")
}

// ------------------------------------------------------------------
// ESTÁGIOS de um pipeline, ordenados. `probability` alimenta previsão
// de fechamento ponderada (soma de valor * probabilidade do estágio).
// ------------------------------------------------------------------
model PipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id])

  name        String
  order       Int
  color       String?
  probability Int?     // 0-100

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals            Deal[]
  historyFromStage DealStageHistory[] @relation("FromStage")
  historyToStage   DealStageHistory[] @relation("ToStage")

  @@unique([pipelineId, order])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

// ------------------------------------------------------------------
// DEALS — a negociação em si. Separado do Contact porque um mesmo
// contato pode ter várias negociações ao longo do tempo.
// Ganhar/perder é um status independente do estágio (não um estágio
// terminal), pra poder reabrir um deal perdido sem perder o histórico.
// ------------------------------------------------------------------
model Deal {
  id             String   @id @default(cuid())
  number         Int      @unique @default(autoincrement()) // identificador curto exibido como "Lead #N"
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  pipelineId     String
  pipeline       Pipeline @relation(fields: [pipelineId], references: [id])

  stageId        String
  stage          PipelineStage @relation(fields: [stageId], references: [id])

  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id])

  title           String
  valueCents      Int?     // guardado em centavos, evita erro de ponto flutuante
  currency        String   @default("BRL")

  status          String    @default("open") // open | won | lost
  lostReason      String?
  wonAt           DateTime?
  lostAt          DateTime?
  expectedCloseAt DateTime?

  assignedUserId String?
  assignedUser   User?    @relation("AssignedDeal", fields: [assignedUserId], references: [id])

  position       Int      @default(0) // ordenação dentro da coluna do Kanban

  customFields   Json     @default("{}") // { [DealCustomFieldDefinition.id]: valor }

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stageHistory   DealStageHistory[]
  tags           DealTag[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@index([tenantId])
  @@index([pipelineId, stageId])
  @@index([tenantId, status])
  @@map("deals")
}

// ------------------------------------------------------------------
// CAMPOS PERSONALIZADOS — definidos pelo usuário, valem pra todos os
// leads do tenant. O valor de cada lead fica no Deal.customFields (JSON),
// chaveado pelo id da definição.
// ------------------------------------------------------------------
model DealCustomFieldDefinition {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  name      String
  type      String   @default("text") // text | number | date | select | multi_select
  options   Json     @default("[]") // lista de strings — só usado quando type é select ou multi_select
  order     Int      @default(0)

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("deal_custom_field_definitions")
}

// ------------------------------------------------------------------
// HISTÓRICO de mudança de estágio de um deal — base pra relatórios
// futuros do tipo "tempo médio em cada estágio".
// ------------------------------------------------------------------
model DealStageHistory {
  id            String   @id @default(cuid())
  dealId        String
  deal          Deal     @relation(fields: [dealId], references: [id])

  fromStageId   String?
  fromStage     PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id])

  toStageId     String
  toStage       PipelineStage  @relation("ToStage", fields: [toStageId], references: [id])

  movedByUserId String?
  movedAt       DateTime @default(now())

  @@index([dealId])
  @@map("deal_stage_history")
}

// ------------------------------------------------------------------
// TAGS — rótulos reutilizáveis por tenant, aplicáveis a Contact e Deal.
// `slug` é a versão normalizada do nome, usada pra evitar duplicata
// por diferença de maiúscula/minúscula ("Vip" vs "VIP").
// ------------------------------------------------------------------
model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  name      String
  slug      String
  color     String   @default("#6b7280")

  createdAt DateTime @default(now())

  contacts  ContactTag[]
  deals     DealTag[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("tags")
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id])

  createdAt DateTime @default(now())

  @@id([contactId, tagId])
  @@index([tagId])
  @@map("contact_tags")
}

model DealTag {
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id])

  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id])

  createdAt DateTime @default(now())

  @@id([dealId, tagId])
  @@index([tagId])
  @@map("deal_tags")
}

// ------------------------------------------------------------------
// TASKS — follow-ups. Nem toda task é sobre um deal específico, por
// isso contactId e dealId são opcionais e independentes.
// ------------------------------------------------------------------
model Task {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  title       String
  description String?
  type        String?  // call | whatsapp | email | meeting | other

  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])

  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id])

  // De qual conversa essa task foi criada (ex: "agendar follow-up" durante
  // um atendimento) — opcional, uma task pode nascer de outros lugares.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  assignedUserId String?
  assignedUser   User?  @relation("AssignedTask", fields: [assignedUserId], references: [id])

  dueAt       DateTime
  priority    String   @default("medium") // low | medium | high
  status      String   @default("pending") // pending | completed | canceled
  completedAt DateTime?

  // Marca quando o scheduler já emitiu o evento "task.overdue" pra essa
  // task, pra não disparar de novo a cada varredura.
  overdueNotifiedAt DateTime?

  // Toda task tem um compromisso correspondente no calendário (criado e
  // mantido automaticamente pelo taskService) — é o que faz a task
  // aparecer na visão de calendário e, dali, sincronizar com o Google.
  calendarEvent CalendarEvent?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status, dueAt])
  @@index([contactId])
  @@index([dealId])
  @@index([conversationId])
  @@map("tasks")
}

// ------------------------------------------------------------------
// CALENDÁRIO — reuniões/compromissos. `reminderMinutesBefore` e
// `reminderSentAt` já ficam prontos pro futuro worker de lembrete via
// WhatsApp (ainda não construído — depende de template aprovado pela
// Meta e de um número WhatsApp de verdade conectado pra testar).
// ------------------------------------------------------------------
model CalendarEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  title       String
  description String?

  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)

  location    String?
  meetingUrl  String?

  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])

  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id])

  assignedUserId String?
  assignedUser   User?  @relation("AssignedCalendarEvent", fields: [assignedUserId], references: [id])

  status      String   @default("scheduled") // scheduled | completed | canceled

  reminderMinutesBefore Int?
  reminderSentAt        DateTime?

  // Presente quando esse evento foi gerado a partir de uma Task (ver
  // taskService) — editar/concluir/excluir esse evento nesse caso deve
  // passar pelos endpoints de /tasks, não direto por aqui.
  taskId      String?  @unique
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Espelho no Google Calendar do usuário responsável (ver
  // GoogleCalendarAccount) — preenchido pelo googleCalendarSync depois
  // que o evento é criado/atualizado por lá, ou quando o evento foi
  // importado de lá pra cá (sincronização é via de mão dupla).
  googleEventId  String?
  googleSyncedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, startAt])
  @@index([contactId])
  @@index([dealId])
  // Chave usada pelo pull do Google Calendar pra achar/atualizar o espelho
  // local de um evento (em vez de duplicar a cada sincronização).
  @@unique([assignedUserId, googleEventId])
  @@map("calendar_events")
}

// ------------------------------------------------------------------
// GOOGLE CALENDAR — conexão pessoal de cada usuário (agente) com sua
// conta Google, via OAuth2. Quando conectado, os CalendarEvent onde
// ele é o assignedUser passam a sincronizar com o Google Calendar dele.
// ------------------------------------------------------------------
model GoogleCalendarAccount {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  googleEmail String?
  calendarId  String  @default("primary")

  accessTokenEncrypted  String
  refreshTokenEncrypted String
  scope                 String?
  expiresAt             DateTime

  // Cursor de sincronização incremental da Google Calendar API — quando
  // presente, o próximo pull só busca o que mudou desde a última vez
  // (em vez de refazer a lista inteira). Nulo força um full sync.
  googleSyncToken String?
  lastGoogleSyncAt DateTime?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("google_calendar_accounts")
}

// ------------------------------------------------------------------
// WEBHOOKS DE SAÍDA — o CRM emite eventos (deal mudou de estágio, task
// venceu, etc.) pra URLs configuradas por tenant. É assim que o n8n (ou
// qualquer outra ferramenta) vira o "cérebro" da automação, sem a gente
// ter que construir um motor de regras interno.
// ------------------------------------------------------------------
model AutomationWebhook {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  name      String
  url       String
  secret    String   // assina o payload de saída (HMAC), receptor confere igual fazemos no webhook inbound da Meta
  events    String[] @default([]) // vazio = todos os eventos; ou lista tipo ["deal.stage_changed"]
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries AutomationDelivery[]

  @@index([tenantId])
  @@map("automation_webhooks")
}

// Log de cada tentativa de entrega — pra debugar automação sem adivinhar
// se o n8n recebeu ou não.
model AutomationDelivery {
  id        String   @id @default(cuid())
  webhookId String
  webhook   AutomationWebhook @relation(fields: [webhookId], references: [id])

  jobId     String   @unique // id do job no BullMQ, usado pra atualizar esse registro a cada retry
  event     String
  payload   Json

  status         String @default("pending") // pending | delivered | failed
  responseStatus Int?
  error          String?
  attemptCount   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([webhookId])
  @@map("automation_deliveries")
}

// ------------------------------------------------------------------
// REGRAS DE AUTOMAÇÃO INTERNA — "quando X acontece, faz Y" dentro do
// próprio CRM (sem depender de ferramenta externa tipo n8n). Reaproveita
// o mesmo catálogo de eventos emitido por emitAutomationEvent().
//
// Decisão de segurança: as ações executadas por uma regra NÃO emitem
// novos eventos de automação — evita loop infinito (regra A move pro
// estágio X, regra B move de volta pro Y, repetindo pra sempre).
// ------------------------------------------------------------------
model AutomationRule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  name              String
  triggerEvent      String  // ex: "deal.stage_changed"
  triggerConditions Json?   // ex: {"toStageId": "xyz"} — todos os pares precisam bater
  actions           Json    // array de ações, executadas em ordem
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs AutomationRuleRun[]

  @@index([tenantId])
  @@index([tenantId, triggerEvent])
  @@map("automation_rules")
}

// Log de execução de cada regra — mesmo raciocínio do AutomationDelivery,
// mas pra ação interna em vez de webhook de saída.
model AutomationRuleRun {
  id     String         @id @default(cuid())
  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id])

  jobId       String @unique
  event       String
  triggerData Json

  status String  @default("pending") // pending | success | failed
  error  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruleId])
  @@map("automation_rule_runs")
}
