generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (porta 6543) — usado em runtime
  directUrl = env("DIRECT_URL")   // conexão direta (porta 5432) — usada só pelo prisma migrate
}

// ------------------------------------------------------------------
// TENANT — cada cliente que assina o seu CRM
// ------------------------------------------------------------------
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("trial")
  status    String   @default("active") // active | suspended | canceled
  createdAt DateTime @default(now())

  users             User[]
  contacts          Contact[]
  conversations     Conversation[]
  messages          Message[]
  templates         Template[]
  whatsappAccounts  TenantWhatsappAccount[]
  webhookEvents     WebhookEvent[]
  pipelines         Pipeline[]
  deals             Deal[]
  tags              Tag[]
  tasks             Task[]

  @@map("tenants")
}

// ------------------------------------------------------------------
// CONEXÃO WHATSAPP DO TENANT — resultado do Embedded Signup
// phoneNumberId é a chave que a Meta manda em TODO webhook,
// é por ela que descobrimos a qual tenant o evento pertence.
// ------------------------------------------------------------------
model TenantWhatsappAccount {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  wabaId            String   // WhatsApp Business Account ID
  phoneNumberId     String   @unique // usado para rotear webhooks -> tenant
  businessId        String?
  displayPhoneNumber String?

  accessTokenEncrypted String  // token de acesso do tenant, criptografado
  tokenStatus           String @default("active") // active | revoked | expired

  qualityRating     String?  // GREEN | YELLOW | RED
  messagingTier     String?

  // Coexistência: número continua ativo no WhatsApp Business App (celular)
  // além da Cloud API. Ver docs: onboarding-business-app-users.
  isCoexistence      Boolean  @default(false)
  platformType       String?  // CLOUD_API | ON_PREMISE (retornado pela Graph API)
  historySyncStatus  String?  // pending | in_progress | completed | declined | failed

  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@map("tenant_whatsapp_accounts")
}

// ------------------------------------------------------------------
// USUÁRIOS (atendentes/admins) DE CADA TENANT
// ------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  name         String
  email        String
  passwordHash String
  role         String   @default("agent") // admin | agent

  createdAt    DateTime @default(now())

  assignedConversations Conversation[] @relation("AssignedAgent")
  assignedDeals         Deal[]         @relation("AssignedDeal")
  assignedTasks         Task[]         @relation("AssignedTask")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ------------------------------------------------------------------
// CONTATOS
// ------------------------------------------------------------------
model Contact {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  phone     String   // formato E.164
  name      String?

  createdAt DateTime @default(now())

  conversations Conversation[]
  deals         Deal[]
  tags          ContactTag[]
  tasks         Task[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("contacts")
}

// ------------------------------------------------------------------
// CONVERSAS
// ------------------------------------------------------------------
model Conversation {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id])

  status         String   @default("open") // open | pending | closed
  assignedUserId String?
  assignedUser   User?    @relation("AssignedAgent", fields: [assignedUserId], references: [id])

  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  messages       Message[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("conversations")
}

// ------------------------------------------------------------------
// MENSAGENS
// ------------------------------------------------------------------
model Message {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id])

  direction         String   // inbound | outbound
  type              String   // text | image | audio | document | template | ...
  content           Json     // payload normalizado (texto, mídia, etc.)

  whatsappMessageId String?  @unique // id retornado pela Graph API
  status            String   @default("pending") // pending | sent | delivered | read | failed

  // De onde a mensagem veio: api (enviada/recebida via Cloud API normal),
  // business_app (enviada pelo app do celular, em contas com coexistência),
  // history_sync (importada do histórico antigo no momento da coexistência)
  source            String   @default("api")

  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@index([conversationId])
  @@map("messages")
}

// ------------------------------------------------------------------
// TEMPLATES
// ------------------------------------------------------------------
model Template {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  name       String
  category   String
  language   String   @default("pt_BR")
  bodyText   String
  metaStatus String   @default("pending") // pending | approved | rejected

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, name, language])
  @@index([tenantId])
  @@map("templates")
}

// ------------------------------------------------------------------
// WEBHOOK EVENTS — peça de idempotência e auditoria
// tenantId fica nullable pois, no momento em que o evento chega
// na fila, ainda não resolvemos a qual tenant ele pertence.
// ------------------------------------------------------------------
model WebhookEvent {
  id                String   @id @default(cuid())
  tenantId          String?
  tenant            Tenant?  @relation(fields: [tenantId], references: [id])

  whatsappEventKey  String   @unique // messageId (inbound) ou messageId+status (status update)
  phoneNumberId     String
  payload           Json
  processedAt       DateTime?
  error             String?

  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@map("webhook_events")
}

// ------------------------------------------------------------------
// PIPELINES — funis de negociação customizáveis por tenant
// (ex: "Vendas", "Suporte Premium"). Nunca deletados de verdade,
// só arquivados, pra preservar o histórico dos deals antigos.
// ------------------------------------------------------------------
model Pipeline {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  name       String
  isDefault  Boolean   @default(false)
  archivedAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  stages     PipelineStage[]
  deals      Deal[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("pipelines")
}

// ------------------------------------------------------------------
// ESTÁGIOS de um pipeline, ordenados. `probability` alimenta previsão
// de fechamento ponderada (soma de valor * probabilidade do estágio).
// ------------------------------------------------------------------
model PipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id])

  name        String
  order       Int
  color       String?
  probability Int?     // 0-100

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals            Deal[]
  historyFromStage DealStageHistory[] @relation("FromStage")
  historyToStage   DealStageHistory[] @relation("ToStage")

  @@unique([pipelineId, order])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

// ------------------------------------------------------------------
// DEALS — a negociação em si. Separado do Contact porque um mesmo
// contato pode ter várias negociações ao longo do tempo.
// Ganhar/perder é um status independente do estágio (não um estágio
// terminal), pra poder reabrir um deal perdido sem perder o histórico.
// ------------------------------------------------------------------
model Deal {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  pipelineId     String
  pipeline       Pipeline @relation(fields: [pipelineId], references: [id])

  stageId        String
  stage          PipelineStage @relation(fields: [stageId], references: [id])

  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id])

  title           String
  valueCents      Int?     // guardado em centavos, evita erro de ponto flutuante
  currency        String   @default("BRL")

  status          String    @default("open") // open | won | lost
  lostReason      String?
  wonAt           DateTime?
  lostAt          DateTime?
  expectedCloseAt DateTime?

  assignedUserId String?
  assignedUser   User?    @relation("AssignedDeal", fields: [assignedUserId], references: [id])

  position       Int      @default(0) // ordenação dentro da coluna do Kanban

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stageHistory   DealStageHistory[]
  tags           DealTag[]
  tasks          Task[]

  @@index([tenantId])
  @@index([pipelineId, stageId])
  @@index([tenantId, status])
  @@map("deals")
}

// ------------------------------------------------------------------
// HISTÓRICO de mudança de estágio de um deal — base pra relatórios
// futuros do tipo "tempo médio em cada estágio".
// ------------------------------------------------------------------
model DealStageHistory {
  id            String   @id @default(cuid())
  dealId        String
  deal          Deal     @relation(fields: [dealId], references: [id])

  fromStageId   String?
  fromStage     PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id])

  toStageId     String
  toStage       PipelineStage  @relation("ToStage", fields: [toStageId], references: [id])

  movedByUserId String?
  movedAt       DateTime @default(now())

  @@index([dealId])
  @@map("deal_stage_history")
}

// ------------------------------------------------------------------
// TAGS — rótulos reutilizáveis por tenant, aplicáveis a Contact e Deal.
// `slug` é a versão normalizada do nome, usada pra evitar duplicata
// por diferença de maiúscula/minúscula ("Vip" vs "VIP").
// ------------------------------------------------------------------
model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  name      String
  slug      String
  color     String   @default("#6b7280")

  createdAt DateTime @default(now())

  contacts  ContactTag[]
  deals     DealTag[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("tags")
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id])

  createdAt DateTime @default(now())

  @@id([contactId, tagId])
  @@index([tagId])
  @@map("contact_tags")
}

model DealTag {
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id])

  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id])

  createdAt DateTime @default(now())

  @@id([dealId, tagId])
  @@index([tagId])
  @@map("deal_tags")
}

// ------------------------------------------------------------------
// TASKS — follow-ups. Nem toda task é sobre um deal específico, por
// isso contactId e dealId são opcionais e independentes.
// ------------------------------------------------------------------
model Task {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  title       String
  description String?
  type        String?  // call | whatsapp | email | meeting | other

  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])

  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id])

  assignedUserId String?
  assignedUser   User?  @relation("AssignedTask", fields: [assignedUserId], references: [id])

  dueAt       DateTime
  priority    String   @default("medium") // low | medium | high
  status      String   @default("pending") // pending | completed | canceled
  completedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status, dueAt])
  @@index([contactId])
  @@index([dealId])
  @@map("tasks")
}
