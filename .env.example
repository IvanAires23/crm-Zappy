# --- App ---
PORT=3000
JWT_SECRET=troque_isso_por_um_segredo_forte

# --- Banco ---
# DATABASE_URL: usada em runtime pela aplicação. Em produção com Supabase,
# aponte pro *pooler* (Transaction mode, porta 6543).
DATABASE_URL="postgresql://crm:crm@localhost:5432/whatsapp_crm?schema=public"

# DIRECT_URL: usada só por operações de schema ("prisma migrate deploy"/
# "migrate dev", roda no deploy via docker-entrypoint.sh) — precisa de uma
# conexão que suporte DDL. Em produção com Supabase, NÃO use a conexão
# direta (db.<projeto>.supabase.co), ela costuma exigir IPv6 e falha em
# várias VPS. Use o "Session pooler" (Settings > Database > Connection
# string > aba "Session pooler", porta 5432 no mesmo host do pooler).
# Localmente pode ser igual ao DATABASE_URL.
DIRECT_URL="postgresql://crm:crm@localhost:5432/whatsapp_crm?schema=public"

# --- Redis / Filas ---
REDIS_URL="redis://localhost:6379"

# --- Meta / WhatsApp (nível de APP, não de tenant) ---
# Esse é o SEU app único no Meta for Developers, usado para todos os clientes
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=            # ID da configuração do Embedded Signup (Facebook Login for Business)
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=escolha_uma_string_secreta

# Chave usada para criptografar os access tokens de cada tenant no banco
TOKEN_ENCRYPTION_KEY=gere_uma_chave_de_32_bytes_em_base64

# --- Google Calendar (OAuth2) --- opcionais: sem elas a integração fica
# desligada. Criar em console.cloud.google.com > APIs & Services > Credentials
# (ative a Google Calendar API e configure a tela de consentimento OAuth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google-calendar/callback

# URL do frontend — pra onde o backend redireciona depois do fluxo OAuth do Google
FRONTEND_URL=http://localhost:5173

# --- Sentry (captura de erro) --- opcional: sem ela, nada é enviado, nem
# local nem em produção. Criar em sentry.io > New Project > Node.js, e
# copiar o DSN que aparece na configuração do projeto.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
