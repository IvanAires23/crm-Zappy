# --- App ---
PORT=3000
JWT_SECRET=troque_isso_por_um_segredo_forte

# --- Banco ---
DATABASE_URL="postgresql://crm:crm@localhost:5432/whatsapp_crm?schema=public"

# --- Redis / Filas ---
REDIS_URL="redis://localhost:6379"

# --- Meta / WhatsApp (nível de APP, não de tenant) ---
# Esse é o SEU app único no Meta for Developers, usado para todos os clientes
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=            # ID da configuração do Embedded Signup (Facebook Login for Business)
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=escolha_uma_string_secreta

# Chave usada para criptografar os access tokens de cada tenant no banco
TOKEN_ENCRYPTION_KEY=gere_uma_chave_de_32_bytes_em_base64
